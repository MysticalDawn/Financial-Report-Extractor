# Financial Report Extractor - Environment Variables
# Copy this file to .env and fill in your actual values

# Required: OpenAI API Key for Claude integration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Tokenizers parallelism setting
TOKENIZERS_PARALLELISM=false

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Maximum file size in MB
MAX_FILE_SIZE_MB=50

# Optional: Default context window size
DEFAULT_WINDOW_CHARS=1500
